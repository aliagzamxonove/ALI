<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Lucid Games - Ultra PRO Home</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <style>
    html, body {
      margin: 0;
      padding: 0;
      width: 100vw;
      min-height: 100vh;
      background: #181d2b;
      box-sizing: border-box;
      overflow-x: hidden;
      height: 100%;
    }
    body {
      font-family: 'Orbitron', 'Space Grotesk', sans-serif;
      min-height: 100vh;
      width: 100vw;
      box-sizing: border-box;
      height: 100%;
      display: flex;
      flex-direction: column;
    }
    #bg-animated { position: fixed; inset: 0; z-index: 0; width: 100vw; min-height: 100vh; background: linear-gradient(125deg, #0a172c 0%, #1a2f50 45%, #0f2847 100%); overflow: hidden; }
    #bg-canvas1, #bg-canvas2 { position: absolute; width:100vw; min-height:100vh; inset:0; pointer-events:none; z-index:1; display: block; max-width: 100vw; }
    .header-bar {
      position: fixed; top: 0; left: 50%; transform: translateX(-50%);
      width: 98vw; max-width: 1100px;
      z-index: 20;
      display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center;
      padding: 1.2rem 2.5rem; background: rgba(24,32,54,0.82);
      color: #fff; box-shadow: 0 2px 16px #000b, 0 1px 40px #00ffc840 inset;
      font-size: 1.2rem; border-radius: 20px; margin-top: 1.2vw;
      backdrop-filter: blur(13px);
      border: 1.5px solid #00ffc825;
      user-select: none;
      gap: 0.8em;
      box-sizing: border-box;
    }
    .main-content {
      flex: 1 1 auto;
      width: 100vw;
      box-sizing: border-box;
      padding-top: 120px;
      padding-bottom: 0;
      min-height: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-end;
      position: relative;
      z-index: 2;
    }
    .carousel-bottom-area {
      width: 100vw;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-end;
      position: relative;
      margin-bottom: 0;
    }
    .carousel-container {
      width: flex-end;
      justify-content: center;
      position: relative;
      min-height: 340px;
      box-sizing: border-box;
      scrollbar-width: none;
      -ms-overflow-style: none;
      touch-action: pan-x;
      z-index: 6;
      scroll-behavior: smooth;
      margin-bottom: 24px;
    }
    .carousel-container::-webkit-scrollbar { display: none; }
    .carousel-track {
      display: flex;
      align-items: flex-end;
      gap: 2vw;
      padding-bottom: 0;
      user-select: none;
      box-sizing: border-box;
      width: max-content;
      min-width: 100vw;
    }
    .game-house {
      position: relative;
      width: 60vw; max-width: 520px; min-width: 220px;
      height: 340px;
      background: rgba(48,53,65,0.10);
      border-radius: 34px;
      box-shadow: 0 30px 70px #0008, 0 1px 40px #00ffc840 inset;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      margin-bottom: 0;
      transition: transform 0.5s, filter 0.4s, box-shadow 0.4s;
      cursor: pointer;
      z-index: 2;
      pointer-events: auto;
      border: 2.5px solid rgba(0,255,200,0.03);
      outline: none;
      scroll-snap-align: center;
      scroll-margin-inline: 50vw;
      box-sizing: border-box;
    }
    .game-house.selected {
      transform: scale(1.16) translateY(-33px) rotateY(-4deg);
      box-shadow: 0 30px 110px #00ffc8b0, 0 1px 60px #fff2 inset;
      filter: brightness(1.18) drop-shadow(0 0 24px #00ffc8cc);
      z-index: 11;
      border: 2.5px solid #00ffc8d9;
    }
    .game-house.locked {
      filter: grayscale(0.9) blur(1.5px) brightness(0.7) contrast(1.2);
      cursor: not-allowed;
      box-shadow: 0 3px 60px #000b;
      border: 2.5px solid #ffeb3b60;
    }
    .game-house img {
      width: 90%;
      max-width: 440px;
      height: 60%;
      object-fit: contain;
      margin-bottom: -14px;
      box-shadow: 0 20px 70px #0004;
      border-radius: 24px 24px 32px 32px;
      background: rgba(19,29,32,0.8);
      border: 2px solid #fff2;
      display: block;
      margin-left: auto; margin-right: auto;
      pointer-events: none;
      user-select: none;
    }
    .house-shadow {
      position: absolute; bottom: 22px; left: 50%; transform: translateX(-50%);
      width: 130px; height: 36px;
      background: radial-gradient(ellipse at center, #0008 65%, transparent 100%);
      filter: blur(6px);
      opacity: 0.48;
      z-index: 1;
      pointer-events: none;
      user-select: none;
    }
    .flying-obj {
      position: absolute; left: 50%; top: -70px; transform: translateX(-50%);
      width: 84px; height: 84px; z-index: 3;
      pointer-events: none;
    }
    .lock-overlay {
      position: absolute; top: 0; left: 0; width: 100%; height: 100%;
      background: linear-gradient(120deg,rgba(22,22,22,0.43) 40%,rgba(0,0,0,0.71) 100%);
      border-radius: 34px;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      z-index: 9; color: #fff;
      backdrop-filter: blur(4px);
      border: 1.5px solid #ffeb3b80;
      box-shadow: 0 0 22px #ffeb3b40;
      animation: fadeIn 0.4s;
    }
    .lock-icon { font-size: 2.8rem; margin-bottom: 1rem; color: #ffeb3b; text-shadow: 0 6px 18px #000a; filter: drop-shadow(0 0 8px #fff4);}
    .unlock-btn { margin-top: 1rem; padding: .65em 2.1em; font-size: 1.13rem; font-weight: 700; border-radius: 2em; border: none; background: linear-gradient(95deg, #00ffc8, #1a237e 90%); color: #1a237e; box-shadow: 0 3px 12px #00ffc8b3; cursor: pointer; transition: background .2s, color .2s; letter-spacing: 1px;}
    .unlock-btn:disabled { background: #aaa; color: #fff; cursor: not-allowed;}
    #ground-3d {
      position: fixed;
      left: 0;
      bottom: 0;
      width: 100vw;
      height: 270px;
      z-index: 3;
      pointer-events: none;
      background: url('ground.png') center bottom / cover no-repeat;
      box-shadow: 0 -12px 40px 0 #000e;
      transition: box-shadow .22s;
    }
    #ground-3d-fade {
      position: absolute;
      left: 0; top: 0; width: 100vw; height: 70px;
      background: linear-gradient(to bottom, rgba(24,29,43,1) 0%, rgba(24,29,43,0) 100%);
      pointer-events: none;
      z-index: 4;
    }
    #preload-overlay {
      position: fixed; inset: 0; z-index: 9999;
      background: #181d2b;
      color: #00ffc8;
      display: flex; align-items: center; justify-content: center;
      font-size: 2.1em;
      font-family: 'Orbitron', 'Space Grotesk', sans-serif;
      letter-spacing: 2px;
      transition: opacity 0.3s;
    }
    #preload-progress { font-size: 1.1em; margin-top: 1.3em; color: #fff; display: block;}
    #preload-overlay.hide { opacity: 0; pointer-events: none; transition: opacity 0.8s;}
    #proModal {
      position:fixed; z-index:1002; inset:0; display:none; align-items:center; justify-content:center;
      background:rgba(18,22,36,0.63);
      backdrop-filter: blur(6px);
      transition: background .22s;
    }
    #proModal.show { display:flex; }
    #proModalBackdrop { display:none; }
    #proModalContent {
      position:relative;
      min-width:320px; max-width:98vw;
      background:linear-gradient(120deg,#232b47 60%,#101a2c 100%);
      border-radius:26px;
      box-shadow:0 2px 32px #00ffc860, 0 1px 40px #fff2 inset;
      padding:2.3em 2.4em 1.7em 2.4em; z-index:101; animation:popIn .33s;
      display:flex; flex-direction:column; align-items:center;
      border: 2.5px solid #00ffc860;
      filter: drop-shadow(0 0 24px #00ffc8c8);
    }
    #proModalTitle {
      font-size:1.55em; font-weight:700; color:#00ffc8; margin-bottom:0.7em; letter-spacing:1.3px;
      text-shadow: 0 2px 14px #001b, 0 0 8px #00ffc8;
      width:100%;
      text-align:center;
    }
    #proModalMsg {
      font-size:1.14em; color:#fff; margin-bottom:1.6em; text-align:center;
      width:100%;
      max-width:400px;
      text-shadow: 0 1px 2px #000b;
      line-height: 1.55em;
    }
    #proModalActions {
      display:flex; gap:1.2em; justify-content:center;
      width:100%;
    }
    .pro-btn {
      padding:.65em 2.1em; border:none; border-radius:2em; font-weight:700;
      font-size:1.11em; cursor:pointer;
      transition:background .2s, color .2s, box-shadow .2s;
      box-shadow:0 4px 14px #00ffc8a8;
      background:linear-gradient(90deg,#00ffc8,#1a237e 90%);
      color:#1a237e;
      text-shadow: 0 2px 8px #fff2;
    }
    .pro-btn.cancel {
      background:rgba(255,255,255,0.08); color:#fff; box-shadow:none;
      border:1.5px solid #00ffc850;
    }
    #highScoresBoard {
      display: flex; flex-direction: column; gap: 1em;
      padding: 0.6em 0.8em 0.2em 0.8em;
      min-width: 290px;
      width: 100%;
      background: linear-gradient(110deg, #222c44 40%, #10151f 100%);
      border-radius: 15px;
      box-shadow: 0 2px 24px #00ffc850 inset;
      margin-bottom:0.9em;
    }
    .hs-row {
      display: flex; align-items: center; gap: 1.2em;
      background: linear-gradient(90deg, #191f33 80%, #293a5a 100%);
      border-radius: 14px;
      padding: 0.8em 1.2em 0.8em 1.2em;
      font-size: 1.18em;
      box-shadow: 0 2px 8px #00ffc830;
      margin-bottom: 0.5em;
      position: relative;
      border: 2px solid #00ffc850;
    }
    .hs-row .hs-icon {
      font-size: 2.1em;
      width: 42px; height: 42px;
      display: flex; align-items: center; justify-content: center;
      background: linear-gradient(120deg, #00ffc8 40%, #ffe46f 100%);
      border-radius: 50%;
      box-shadow: 0 1px 10px #fff6;
      color: #1a237e;
      margin-right: 0.6em;
      border: 1.5px solid #fff7;
      filter: drop-shadow(0 0 8px #00ffc8c0);
    }
    .hs-row .hs-game {
      font-weight: 700;
      color: #ffe46f;
      font-size: 1.11em;
      flex: 1;
      text-shadow: 0 2px 8px #fff2;
    }
    .hs-row .hs-score {
      font-weight: 800;
      color: #fff;
      font-size: 1.21em;
      margin-left: 1em;
      text-shadow: 0 2px 8px #00ffc8b0;
      background: linear-gradient(90deg, #ffe46f 30%, #fff 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    @keyframes fadeIn {0%{opacity:0}100%{opacity:1}}
    @keyframes popIn {0%{transform:scale(0.93);opacity:0}100%{transform:scale(1);opacity:1}}
    @media (max-width: 950px) {
      .main-content { padding-top: 95px;}
      .carousel-container { min-height: 140px; }
      .game-house { width: 170px; height: 140px;}
      .game-house img { width: 100px; height: 60px;}
      .house-shadow { width: 60px; height: 14px;}
      #ground-3d { height: 90px;}
    }
    @media (max-width: 600px) {
      .main-content { padding-top: 72px;}
      .carousel-container { min-height: 100px;}
      .game-house { width: 120px; height: 110px;}
      .game-house img { width: 68px; height: 48px;}
      .house-shadow { width: 40px; height: 9px;}
      #ground-3d { height: 60px;}
      #proModalContent { min-width: unset; padding: 1.2em 0.5em 0.8em 0.5em;}
    }
  </style>
</head>
<body>
  <div id="preload-overlay">
    <div>
      Loading assets...<br>
      <span id="preload-progress">0%</span>
    </div>
  </div>
  <div id="bg-animated">
    <canvas id="bg-canvas1"></canvas>
    <canvas id="bg-canvas2"></canvas>
  </div>
  <div class="header-bar">
    <div class="coin-count"><i class="fas fa-coins"></i> <span id="coinCount">0</span></div>
    <div class="lucid-coin-ui">
      <div class="lucid-piece-stack">
        <img class="lucid-piece-img" id="lucidPieceImg1" src="lucid_piece1.png" alt="Lucid Piece 1">
        <img class="lucid-piece-img" id="lucidPieceImg2" src="lucid_piece2.png" alt="Lucid Piece 2">
        <img class="lucid-piece-img" id="lucidPieceImg3" src="lucid_piece3.png" alt="Lucid Piece 3">
      </div>
      <img class="lucid-coin-img" id="lucidCoinTotalImg" src="lucid_coin_total.png" alt="Total Lucid Coin">
      <span id="lucidCoinCount" class="lucid-coin-count">0</span>
      <button id="lucidCoinInfoBtn" class="lucid-coin-info-btn" title="What are Lucid Coins?"><i class="fas fa-circle-info"></i></button>
    </div>
    <div class="high-score" id="highScoreBoardBtn"><i class="fas fa-trophy"></i> <span id="highScore">0</span></div>
  </div>
  <div class="main-content">
    <div class="carousel-bottom-area">
      <div class="carousel-container" id="carouselContainer">
        <div class="carousel-track" id="carouselTrack"></div>
      </div>
    </div>
  </div>
  <div id="ground-3d">
    <div id="ground-3d-fade"></div>
  </div>
  <div id="proModal">
    <div id="proModalBackdrop"></div>
    <div id="proModalContent" role="dialog" aria-modal="true">
      <div id="proModalTitle"></div>
      <div id="proModalMsg"></div>
      <div id="proModalActions"></div>
    </div>
  </div>
  <script>
    // ---- HARDCODED PRELOAD ALL MEDIA ----
    const mediaAssets = [
      'ground.png',
      'house1.png', 'house2.png', 'house3.png', 'house4.png', 'house5.png',
      'lucid_piece1.png', 'lucid_piece2.png', 'lucid_piece3.png',
      'lucid_coin_total.png'
    ];
    let loadedCount = 0;
    function updatePreloadProgress() {
      const percent = Math.round((loadedCount / mediaAssets.length) * 100);
      document.getElementById('preload-progress').textContent = percent + '%';
    }
    function preloadAllMedia(callback) {
      let loaded = 0;
      function singleLoaded() {
        loadedCount++;
        updatePreloadProgress();
        if (loadedCount >= mediaAssets.length) {
          setTimeout(callback, 300); // slight delay for smoothness
        }
      }
      for (const src of mediaAssets) {
        const img = new window.Image();
        img.onload = singleLoaded;
        img.onerror = singleLoaded;
        img.src = src;
      }
    }
    preloadAllMedia(() => {
      document.getElementById('preload-overlay').classList.add('hide');
      setTimeout(() => {
        document.getElementById('preload-overlay').style.display = 'none';
      }, 1000);
      window.startApp && window.startApp();
    });
    // ---- END PRELOAD ----

    window.startApp = function() {
      // --- Animated background: rays & particles (unchanged) ---
      const c1 = document.getElementById('bg-canvas1');
      c1.width = window.innerWidth; c1.height = window.innerHeight;
      const ctx1 = c1.getContext('2d');
      let rays = Array.from({length:7},()=>({
        x:Math.random()*c1.width, y:Math.random()*c1.height*0.6,
        len:Math.random()*180+150, w:Math.random()*22+7, a:Math.random()*6.28,
        hue:Math.floor(Math.random()*40+170), speed:(Math.random()*0.33)+0.07, alpha:Math.random()*0.19+0.14
      }));
      function drawRays(){
        ctx1.clearRect(0,0,c1.width,c1.height);
        for(const r of rays){
          ctx1.save();
          ctx1.translate(r.x, r.y);
          ctx1.rotate(r.a);
          let grad = ctx1.createLinearGradient(0,0,r.len,0);
          grad.addColorStop(0,`hsla(${r.hue},90%,70%,${r.alpha*0.66})`);
          grad.addColorStop(1,`hsla(${r.hue},90%,40%,0)`);
          ctx1.fillStyle = grad;
          ctx1.globalAlpha = r.alpha;
          ctx1.beginPath();
          ctx1.ellipse(r.len/2,0,r.len/2,r.w,0,0,Math.PI*2);
          ctx1.fill();
          ctx1.restore();
          r.a += 0.0007+r.speed/700;
          r.x += Math.sin(r.a)*r.speed;
          r.y += Math.cos(r.a)*r.speed*0.5;
          if(r.x<0||r.x>c1.width||r.y<0||r.y>c1.height*0.65){ r.x=Math.random()*c1.width; r.y=Math.random()*c1.height*0.7;}
        }
        requestAnimationFrame(drawRays);
      } drawRays();
      window.addEventListener('resize',()=>{ c1.width=window.innerWidth; c1.height=window.innerHeight; });

      const c2 = document.getElementById('bg-canvas2');
      c2.width = window.innerWidth; c2.height = window.innerHeight;
      const ctx2 = c2.getContext('2d');
      const particles = Array.from({length:33},()=>({
        x: Math.random()*c2.width,
        y: Math.random()*c2.height,
        r: Math.random()*2.8+1.2,
        dx: (Math.random()-0.5)*0.10,
        dy: (Math.random()-0.5)*0.13,
        alpha: Math.random()*0.23+0.1
      }));
      function drawParticles(){
        ctx2.clearRect(0,0,c2.width,c2.height);
        for(const p of particles){
          ctx2.globalAlpha = p.alpha;
          ctx2.beginPath();
          ctx2.arc(p.x,p.y,p.r,0,Math.PI*2);
          ctx2.fillStyle="#fff";
          ctx2.shadowColor="#00ffc8"; ctx2.shadowBlur=7;
          ctx2.fill();
          ctx2.shadowBlur=0;
          p.x+=p.dx; p.y+=p.dy;
          if(p.x<0) p.x=c2.width; if(p.x>c2.width) p.x=0;
          if(p.y<0) p.y=c2.height; if(p.y>c2.height) p.y=0;
        }
        requestAnimationFrame(drawParticles);
      } drawParticles();
      window.addEventListener('resize',()=>{ c2.width=window.innerWidth; c2.height=window.innerHeight; });

      function showProModal({title, message, actions}) {
        const modal = document.getElementById('proModal');
        modal.classList.add('show');
        document.getElementById('proModalTitle').textContent = title;
        document.getElementById('proModalMsg').innerHTML = message;
        const $actions = document.getElementById('proModalActions');
        $actions.innerHTML = '';
        actions.forEach(({label, callback, className})=>{
          const btn = document.createElement('button');
          btn.className = 'pro-btn'+(className?' '+className:'');
          btn.textContent = label;
          btn.onclick = ()=>{
            modal.classList.remove('show');
            window.onkeydown = null;
            callback && callback();
          };
          $actions.appendChild(btn);
        });
        document.getElementById('proModalBackdrop').onclick = ()=>{
          modal.classList.remove('show');
          window.onkeydown = null;
        };
        window.onkeydown = e => { if(e.key==="Escape") { modal.classList.remove('show'); window.onkeydown = null; } };
      }

      // Game data and logic
      const housePNGs = [
        'house1.png',  // lucidmatch.html (default unlocked)
        'house2.png',
        'house3.png',
        'house4.png',
        'house5.png'
      ];
      const flyingObjects = [
        `<svg width="84" height="84"><g id="starOrbit"></g></svg>`,
        `<svg width="84" height="84"><ellipse cx="42" cy="34" rx="20" ry="10" fill="#a6eaff" opacity="0.7"/><ellipse cx="42" cy="37" rx="12" ry="5" fill="#00ffc8" opacity="0.8"/></svg>`,
        `<svg width="84" height="84"><circle cx="42" cy="38" r="13" fill="#ffe500" opacity="0.75"/><circle cx="42" cy="28" r="7" fill="#fff" opacity="0.8"/></svg>`,
        `<svg width="84" height="84"><ellipse cx="42" cy="34" rx="16" ry="7" fill="#fff" opacity="0.22"/><rect x="28" y="30" width="28" height="18" rx="9" fill="#b3e5fc" /></svg>`,
        `<svg width="84" height="84"><ellipse cx="42" cy="36" rx="13" ry="13" fill="#ffc107" opacity="0.85"/><ellipse cx="42" cy="32" rx="7" ry="3" fill="#fffde7"/></svg>`
      ];
      const gameLinks = [
        'lucidmatch.html', '', '', '', ''
      ];
      const unlockPrices = [0, 300, 900, 2000, 3500];
      const gameNames = [
        "LucidMatch", "DreamBlocks", "GemRunner", "SkyStack", "MindTwist"
      ];
      const gameIcons = [
        '<i class="fas fa-dice-d20"></i>',
        '<i class="fas fa-cube"></i>',
        '<i class="fas fa-gem"></i>',
        '<i class="fas fa-layer-group"></i>',
        '<i class="fas fa-brain"></i>'
      ];

      let unlockedGames = JSON.parse(localStorage.getItem('lucid_unlocked_games')||'[true,false,false,false,false]');
      unlockedGames[0]=true;
      let coins = Number(localStorage.getItem('lucid_coins')||'500');
      let highScore = Number(localStorage.getItem('lucid_highscore')||'0');
      let lucidCoin = Number(localStorage.getItem('lucid_lucidcoin')||'0');
      let lucidPieces = JSON.parse(localStorage.getItem('lucid_pieces')||'[false,false,false]');
      let selectedIdx = 0;
      const $track = document.getElementById('carouselTrack');
      const $coinCount = document.getElementById('coinCount');
      const $highScore = document.getElementById('highScore');
      const $lucidCoinTotalImg = document.getElementById('lucidCoinTotalImg');
      const $lucidCoinCount = document.getElementById('lucidCoinCount');
      const $lucidPieceImgs = [
        document.getElementById('lucidPieceImg1'),
        document.getElementById('lucidPieceImg2'),
        document.getElementById('lucidPieceImg3')
      ];
      const $ground3d = document.getElementById('ground-3d');
      const $highScoreBoardBtn = document.getElementById('highScoreBoardBtn');
      const $lucidCoinInfoBtn = document.getElementById('lucidCoinInfoBtn');
      const $carouselContainer = document.getElementById('carouselContainer');

      function updateHeader() {
        $coinCount.textContent = coins;
        $highScore.textContent = highScore;
        $lucidCoinCount.textContent = lucidCoin;
        for (let i = 0; i < 3; ++i) {
          if (lucidPieces[i]) {
            $lucidPieceImgs[i].classList.add('lucid-piece-collected');
            $lucidPieceImgs[i].classList.remove('lucid-piece-uncollected');
          } else {
            $lucidPieceImgs[i].classList.remove('lucid-piece-collected');
            $lucidPieceImgs[i].classList.add('lucid-piece-uncollected');
          }
        }
      }

      function renderHouses() {
        $track.innerHTML = '';
        for(let i=0;i<5;i++) {
          const house = document.createElement('div');
          house.className = 'game-house' + (i===selectedIdx?' selected':'') + (unlockedGames[i]?'':' locked');
          house.tabIndex = 0;
          house.setAttribute('data-idx', i);
          const img = document.createElement('img');
          img.src = housePNGs[i]; img.alt = 'Game House '+(i+1);
          house.appendChild(img);
          house.appendChild(Object.assign(document.createElement('div'), {className:'house-shadow'}));
          const flying = document.createElement('div');
          flying.className = 'flying-obj';
          if(i === 0) {
            flying.innerHTML = `<svg width="84" height="84"><g id="starOrbit"></g></svg>`;
            setTimeout(()=>{
              const starSVG = flying.querySelector('#starOrbit');
              if(starSVG) drawOrbitingStars(starSVG, 9, 26, 1.0);
            }, 20);
          } else {
            flying.innerHTML = flyingObjects[i];
          }
          house.appendChild(flying);
          if (!unlockedGames[i]) {
            const lock = document.createElement('div');
            lock.className = 'lock-overlay';
            lock.innerHTML = `<span class="lock-icon"><i class="fas fa-lock"></i></span>
              <span style="font-size:1.2em;font-weight:600;">${unlockPrices[i]} <i class="fas fa-coins"></i></span>
              <button class="unlock-btn" data-idx="${i}" ${coins<unlockPrices[i]?'disabled':''}>Unlock</button>`;
            house.appendChild(lock);
          }
          house.onclick = () => {
            if (unlockedGames[i]) {
              if (gameLinks[i]) window.location = gameLinks[i];
            } else {
              showProModal({
                title: "Unlock Game?",
                message: `Do you want to unlock this game for <b>${unlockPrices[i]} coins</b>?`,
                actions: [
                  {label:"Cancel", className:"cancel"},
                  {label:"Unlock", callback:()=>{ unlockGame(i); }}
                ]
              });
            }
          };
          house.addEventListener('click', (e) => {
            if (selectedIdx !== i && unlockedGames[i]) {
              selectedIdx = i;
              renderHouses();
            }
          });
          $track.appendChild(house);
        }
        updateHeader();
        attachUnlockEvents();
        centerSelectedHouse();
      }

      function unlockGame(i) {
        if (coins>=unlockPrices[i]) {
          coins -= unlockPrices[i];
          unlockedGames[i]=true;
          localStorage.setItem('lucid_unlocked_games',JSON.stringify(unlockedGames));
          localStorage.setItem('lucid_coins',coins);
          renderHouses();
        }
      }

      function centerSelectedHouse() {
        // Center the selected house in the scroll container
        const houses = Array.from($track.children);
        if (!houses.length) return;
        const selected = houses[selectedIdx];
        if (!selected) return;
        // scroll-margin-inline ensures snap is perfect, but we scrollTo manually for keyboard navigation
        const containerRect = $carouselContainer.getBoundingClientRect();
        const selectedRect = selected.getBoundingClientRect();
        const scrollLeft = selected.offsetLeft + selected.offsetWidth/2 - containerRect.width/2;
        $carouselContainer.scrollTo({
          left: scrollLeft,
          behavior: "smooth"
        });
      }

      window.addEventListener('resize', () => {
        centerSelectedHouse();
      });

      function attachUnlockEvents() {
        document.querySelectorAll('.unlock-btn').forEach(btn=>{
          btn.onclick = e=>{
            e.stopPropagation();
            const i = Number(btn.dataset.idx);
            showProModal({
              title: "Unlock Game?",
              message: `Do you want to unlock this game for <b>${unlockPrices[i]} coins</b>?`,
              actions: [
                {label:"Cancel", className:"cancel"},
                {label:"Unlock", callback:()=>{ unlockGame(i); }}
              ]
            });
          };
        });
      }

      document.body.addEventListener('keydown',e=>{
        if (document.activeElement.tagName === 'INPUT' || document.activeElement.tagName === 'TEXTAREA') return;
        if (e.key==='ArrowRight') {
          if (selectedIdx < 4) {
            selectedIdx++;
            renderHouses();
          }
        }
        if (e.key==='ArrowLeft') {
          if (selectedIdx > 0) {
            selectedIdx--;
            renderHouses();
          }
        }
      });

      function drawOrbitingStars(parent, count, radius, speed) {
        parent.innerHTML = '';
        for (let i = 0; i < count; ++i) {
          const star = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
          star.setAttribute('r', 2.3+Math.random()*1.2);
          star.setAttribute('fill', '#fff');
          parent.appendChild(star);
        }
        function animate() {
          const now = Date.now()/1000;
          for (let i = 0; i < count; ++i) {
            const angle = (2 * Math.PI * i / count) + now * speed * (i%2===0?1:-1);
            const r = radius + Math.sin(now*0.6+i)*3;
            parent.children[i].setAttribute('cx', 42 + Math.cos(angle)*r);
            parent.children[i].setAttribute('cy', 42 + Math.sin(angle)*r*0.55);
            parent.children[i].setAttribute('opacity', 0.68 + Math.sin(now*2+i)*0.2);
          }
          requestAnimationFrame(animate);
        } animate();
      }

      $lucidCoinInfoBtn.onclick = function() {
        showProModal({
          title: "Lucid Coin 🪙 Usage",
          message: `<div style="font-size:1.09em;text-align:left;max-width:320px;margin:auto;">
              <b>What are Lucid Coins?</b><br><br>
              <span style="color:#00ffc8">Lucid Coins🪙</span> are rare coins you can collect as jackpot drops.<br>
              <br>
              <b>Use Lucid Coins to continue your game after a Game Over!</b><br>
              <ul style="margin-left:1.5em;">
                <li>First continue: <b>1</b> Lucid Coin</li>
                <li>Second continue: <b>2</b> Lucid Coins</li>
                <li>Third continue: <b>3</b> Lucid Coins</li>
                <li>Fourth time: <span style="color:#f33">No more continues</span></li>
              </ul>
              <br>
              <span style="color:#ffe46f;">Collect more Lucid Coins to get more chances!</span>
            </div>`,
          actions: [{label:"Close", className:"cancel"}]
        });
      };

      $highScoreBoardBtn.onclick = function() {
        let hsList = [];
        let bestOverall = 0;
        for(let i=0;i<5;i++) {
          let score = +(localStorage.getItem('lucid_highscore_'+i)||'0');
          if(score > bestOverall) bestOverall = score;
          hsList.push({
            name: gameNames[i],
            icon: gameIcons[i],
            score: score
          });
        }
        let board = `<div id="highScoresBoard">
          ${hsList.map((g,i)=>`
            <div class="hs-row">
              <span class="hs-icon">${g.icon}</span>
              <span class="hs-game">${g.name}</span>
              <span class="hs-score">${g.score}</span>
            </div>
          `).join('')}
        </div>`;
        showProModal({
          title: "Your Game Awards",
          message: board,
          actions: [
            {label:"Close", className:"cancel"}
          ]
        });
      };

      renderHouses();
      updateHeader();
      setTimeout(centerSelectedHouse, 400);
    }
  </script>
</body>
</html>